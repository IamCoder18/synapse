---
import BaseLayout from '~/components/layout/BaseLayout.astro';
import Nav from '~/components/layout/Nav.astro';
import Footer from '~/components/layout/Footer.astro';

const groovy = `dependencies {
    implementation 'com.aaravlabs:synapse:0.4.0'
    // ... your other FTC deps
}`;

const kotlinDsl = `dependencies {
    implementation("com.aaravlabs:synapse:0.4.0")
}`;

const maven = `<!-- your pom.xml -->
<dependency>
    <groupId>com.aaravlabs</groupId>
    <artifactId>synapse</artifactId>
    <version>0.4.0</version>
</dependency>`;

const gprGroovy = `repositories {
    mavenCentral()
    google()
    maven {
        url = uri("https://maven.pkg.github.com/IamCoder18/synapse")
        credentials {
            username = findProperty("githubUser") ?: System.getenv("GITHUB_USER") ?: System.getenv("GITHUB_ACTOR")
            password = findProperty("githubToken") ?: System.getenv("GITHUB_TOKEN")
        }
    }
}

dependencies {
    implementation 'com.aaravlabs:synapse:0.4.0'
}`;

const gprKotlinDsl = `repositories {
    mavenCentral()
    google()
    maven {
        url = uri("https://maven.pkg.github.com/IamCoder18/synapse")
        credentials {
            username = (findProperty("githubUser") as String?)
                ?: System.getenv("GITHUB_USER")
                ?: System.getenv("GITHUB_ACTOR")
            password = (findProperty("githubToken") as String?)
                ?: System.getenv("GITHUB_TOKEN")
        }
    }
}

dependencies {
    implementation("com.aaravlabs:synapse:0.4.0")
}`;

const gradleProps = `# ~/.gradle/gradle.properties (never commit)
githubUser=<your-github-username>
githubToken=<a-token-with-read:packages>`;
const proguard = `# Already in the JAR. R8 keeps everything you need.
-keep class com.aaravlabs.synapse.** { *; }
-keep @com.aaravlabs.synapse.annotation.* class *`;

const verify = `import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.aaravlabs.synapse.ftc.GamepadAdaptor;
import com.aaravlabs.synapse.ftc.SafeOpMode;

@TeleOp(name = "MyFirstOpMode", group = "Synapse")
public class MyFirstOpMode extends SafeOpMode {
    @Override protected void onSafeInit() {
        // You now have: orchestrator, hardware, safeMap ready.
        GamepadAdaptor.attach(orchestrator, gamepad1, "g1");
    }
    @Override protected void onSafeLoop() {
        telemetry.update();
    }
}`;
---
<BaseLayout
  title="Install"
  description="Add Synapse to your FTC Gradle project in three minutes — no token needed."
>
  <Nav />
  <main class="install">
    <header class="install__hero">
      <h1>Install Synapse</h1>
      <p>One dependency. No token. Three minutes.</p>
      <p class="install__hint">
        Published on <strong>Maven Central</strong> — no authentication and no extra repository
        needed. Full details and troubleshooting: <a href="/docs/get-started/install">the Install guide</a>.
      </p>
    </header>

    <section class="install__step">
      <h2>1. Add the dependency</h2>
      <p class="install__hint">
        The standard FTC template already includes <code>mavenCentral()</code> in its repositories,
        so the dependency is all you need. Pick your build system:
      </p>
      <div class="install__tabs">
        <details open>
          <summary>Gradle (Groovy)</summary>
          <pre><code>{groovy}</code></pre>
        </details>
        <details>
          <summary>Gradle (Kotlin DSL)</summary>
          <pre><code>{kotlinDsl}</code></pre>
        </details>
        <details>
          <summary>Maven</summary>
          <pre><code>{maven}</code></pre>
        </details>
      </div>
    </section>

    <section class="install__step">
      <h2>2. R8 / ProGuard keep rules</h2>
      <p class="install__hint">
        Synapse already ships keep rules in <code>META-INF/proguard/synapse.pro</code>, so minification
        is safe out of the box. You don't need to copy anything — but if you use a custom rules file,
        add the lines below to be explicit:
      </p>
      <pre><code>{proguard}</code></pre>
    </section>

    <section class="install__step">
      <h2>3. Extend SafeOpMode</h2>
      <p class="install__hint">
        Replace <code>extends OpMode</code> with <code>extends SafeOpMode</code> in your OpMode class.
        The base class wires the orchestrator, hardware thread, and a SafeHardwareMap for you.
      </p>
      <pre><code>{verify}</code></pre>
    </section>

    <section class="install__step">
      <h2>4. Verify it works</h2>
      <p class="install__hint">
        Build and run the OpMode above. You should see no errors in logcat and the standard "INIT" →
        "RUN" → "STOP" lifecycle messages from the FTC SDK. If you also see lines like
        <code>created topic ...</code> or <code>registered node ...</code>, the orchestrator is alive.
      </p>
    </section>

    <section class="install__step">
      <h2>5. Optional: enable GamepadAdaptor</h2>
      <p class="install__hint">
        Add this single line inside <code>onSafeInit()</code> to publish every gamepad field as a topic:
      </p>
      <pre><code>GamepadAdaptor.attach(orchestrator, gamepad1, "g1");</code></pre>
      <p class="install__hint">
        See <a href="/docs/ftc/gamepad-adaptor">GamepadAdaptor</a> for the full topic map.
      </p>
    </section>

    <section class="install__step">
      <h2>6. Advanced: GitHub Packages mirror</h2>
      <p class="install__hint">
        Synapse is also mirrored on <code>maven.pkg.github.com/IamCoder18/synapse</code> — useful if
        your organization already authenticates against GitHub. The mirror requires a personal
        access token with the <code>read:packages</code> scope even for public packages (a GitHub
        restriction, not a Synapse one). If in doubt, stay on Maven Central above.
      </p>
      <div class="install__tabs">
        <details>
          <summary>Use the GitHub Packages mirror</summary>
          <p class="install__hint">
            Create a token with the <code>read:packages</code> scope, then put it in
            <code>~/.gradle/gradle.properties</code> (never commit this file):
          </p>
          <pre><code>{gradleProps}</code></pre>
          <p class="install__hint">Add the mirror repository and the dependency:</p>
          <pre><code>{gprGroovy}</code></pre>
          <p class="install__hint">Kotlin DSL:</p>
          <pre><code>{gprKotlinDsl}</code></pre>
          <p class="install__hint">
            Full walkthrough with troubleshooting: <a href="/docs/get-started/install#advanced-github-packages-mirror">the Install guide's GitHub Packages section</a>.
          </p>
        </details>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .install { max-width: 880px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }
  .install a { color: var(--primary); text-decoration: underline; text-underline-offset: 3px; }
  .install__hero { text-align: center; margin-bottom: 3rem; }
  .install__hero h1 { font-size: clamp(2.4rem, 6vw, 3.4rem); margin: 0; }
  .install__hero p { color: var(--muted-foreground); margin-top: 0.7rem; }
  .install__step { margin-bottom: 2.5rem; }
  .install__step h2 { font-size: 1.4rem; margin: 0 0 0.5rem; }
  .install__hint { color: var(--muted-foreground); margin-bottom: 0.9rem; }
  pre { background: var(--muted); border: 1px solid var(--border); padding: 1rem; border-radius: 8px; overflow: auto; }
  code { font-family: var(--font-mono); font-size: 0.9em; }
  p code, h2 code, li code { background: var(--muted); padding: 0.15em 0.4em; border-radius: 4px; }
  pre code { background: transparent; padding: 0; }
  .install__tabs details {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 0.5rem;
    overflow: hidden;
  }
  .install__tabs summary {
    padding: 0.7rem 1rem;
    cursor: pointer;
    color: var(--foreground);
    font-weight: 500;
  }
  .install__tabs summary:hover { background: var(--muted); }
  .install__tabs pre { border: none; border-top: 1px solid var(--border); border-radius: 0; margin: 0; }
</style>
