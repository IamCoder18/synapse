---
import DocsLayout from '~/components/layout/DocsLayout.astro';
import { getCollection } from 'astro:content';
import { docsUrlFromId } from '~/lib/source';
import { GROUP_ORDER, GROUP_TITLES, type DocsGroup } from '~/lib/docs';

const all = await getCollection('docs');

const groups: Record<string, DocsGroup[]> = {};
for (const e of all) {
  const url = docsUrlFromId(e.id);
  if (!url) continue;
  const top = url.split('/')[2];
  if (!top) continue;
  groups[top] ??= [];
  groups[top].push({
    id: e.id,
    title: e.data.title ?? e.id,
    description: e.data.description,
    url,
  });
}
---

<DocsLayout
  title="Docs"
  description="The full guide to using Synapse for FTC robot code."
  groups={groups}
  groupOrder={GROUP_ORDER}
  groupTitles={GROUP_TITLES}
  currentSlug=""
  variant="index"
>
  <p>Welcome. Synapse is a tiny pub/sub bus that gives FTC robot code a single dedicated hardware thread and typed topics for inter-module communication.</p>

  <h2>60-second tour</h2>
  <ol>
    <li>Add the dependency (see <a href="/docs/get-started/install">Install</a>).</li>
    <li>Extend <code>SafeOpMode</code> instead of <code>OpMode</code>.</li>
    <li>Build <code>Node</code>s — one concern each (drive, intake, shooter).</li>
    <li>Use <code>@SubscribedTo</code>, <code>@RunPeriodically</code>, <code>@RunnableAction</code> to wire them up.</li>
    <li>Anything that touches a <code>DcMotorEx</code> / <code>Servo</code> / <code>IMU</code> runs on the hardware thread — read <a href="/docs/concepts/architecture">Architecture</a> to see how.</li>
  </ol>

  {GROUP_ORDER.map((g) => {
    const items = groups[g];
    if (!items) return null;
    return (
      <section class="docs-section">
        <h2>{GROUP_TITLES[g] ?? g}</h2>
        <ul role="list" class="docs-section__list">
          {items.map((i) => (
            <li>
              <a href={i.url}>
                <strong>{i.title}</strong>
                {i.description && <span>{i.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    );
  })}

  <h2>For LLMs and agents</h2>
  <p>Every page is also served as Markdown. See <a href="/llms.txt">llms.txt</a>, <a href="/llms-full.txt">llms-full.txt</a>, and <a href="/docs.md">docs.md</a> at the site root, or append <code>.md</code> to any docs URL.</p>
</DocsLayout>
