---
import { getCollection } from 'astro:content';
import DocsLayout from '~/components/layout/DocsLayout.astro';
import { docsUrlFromId } from '~/lib/source';
import { GROUP_ORDER, GROUP_TITLES, type DocsGroup, type DocsPagerLink } from '~/lib/docs';

export async function getStaticPaths() {
  const all = await getCollection('docs');
  return all
    .map((entry) => {
      const url = docsUrlFromId(entry.id);
      if (!url) return null;
      const slug = url.replace(/^\/docs\//, '').replace(/\/$/, '');
      return {
        params: { slug },
        props: { entry, all },
      };
    })
    .filter((x): x is { params: { slug: string }; props: { entry: any; all: any } } => x !== null);
}

const { entry, all } = Astro.props;
const { Content, headings } = await entry.render();
const title = entry.data.title ?? entry.id;
const description = entry.data.description;
const url = docsUrlFromId(entry.id);
const slug = url ? url.replace(/^\/docs\//, '') : '';

const groups: Record<string, DocsGroup[]> = {};
for (const s of all) {
  const itemUrl = docsUrlFromId(s.id);
  if (!itemUrl) continue;
  const top = itemUrl.split('/')[2];
  if (!top) continue;
  groups[top] ??= [];
  groups[top].push({
    id: s.id,
    title: s.data.title ?? s.id,
    description: s.data.description,
    url: itemUrl,
  });
}

const flatOrder: DocsPagerLink[] = [];
for (const g of GROUP_ORDER) {
  for (const item of groups[g] ?? []) {
    flatOrder.push({ url: item.url, title: item.title });
  }
}
---

<DocsLayout
  title={title}
  description={description}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description: description ?? '',
    url: `/docs/${slug}`,
    author: { '@type': 'Person', name: 'IamCoder18', url: 'https://github.com/IamCoder18' },
    publisher: { '@type': 'Organization', name: 'Synapse', url: '/' },
    isPartOf: { '@type': 'WebSite', name: 'Synapse', url: '/' },
  }}
  groups={groups}
  groupOrder={GROUP_ORDER}
  groupTitles={GROUP_TITLES}
  currentSlug={slug}
  sourcePath={entry.id}
  flatOrder={flatOrder}
  headings={headings}
  variant="article"
>
  <Content />
</DocsLayout>
