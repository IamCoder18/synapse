---
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';
import Search from '~/components/react/Search.tsx';
const path = Astro.url.pathname;
const isActive = (p: string) => path === p || (p !== '/' && path.startsWith(p));
---
<nav class="syn-nav" aria-label="Primary">
  <a href="/" class="syn-nav__brand" aria-label="Synapse home">
    <Logo />
    <span>Synapse</span>
  </a>
  <ul class="syn-nav__links" role="list">
    <li><a href="/docs" aria-current={isActive('/docs') ? 'page' : undefined}>Docs</a></li>
    <li><a href="/install" aria-current={isActive('/install') ? 'page' : undefined}>Install</a></li>
    <li><a href="/changelog" aria-current={isActive('/changelog') ? 'page' : undefined}>Changelog</a></li>
    <li><a href="/community" aria-current={isActive('/community') ? 'page' : undefined}>Community</a></li>
  </ul>
  <div class="syn-nav__right">
    <Search client:load />
    <ThemeToggle />
    <a class="syn-nav__github" href="https://github.com/IamCoder18/synapse" target="_blank" rel="noopener" aria-label="GitHub repository">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-2.1c-3.2.7-3.88-1.37-3.88-1.37-.52-1.32-1.28-1.67-1.28-1.67-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.27-5.23-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.17a10.93 10.93 0 0 1 5.74 0c2.19-1.48 3.15-1.17 3.15-1.17.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.36-5.25 5.65.41.36.78 1.06.78 2.13v3.16c0 .31.21.66.79.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
      </svg>
      <span>GitHub</span>
    </a>
  </div>
</nav>

<style>
  .syn-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.9rem 1.5rem;
    background: color-mix(in oklab, var(--background) 80%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .syn-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--foreground);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .syn-nav__links {
    display: flex;
    gap: 1.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .syn-nav__links a {
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .syn-nav__links a[aria-current='page'] {
    color: var(--foreground);
  }
  .syn-nav__links a:hover { color: var(--foreground); }
  .syn-nav__right {
    margin-left: auto;
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }
  .syn-nav__github {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--foreground);
    text-decoration: none;
    font-size: 0.9rem;
    background: var(--card);
  }
  .syn-nav__github:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  @media (max-width: 900px) {
    .syn-nav { flex-wrap: wrap; gap: 0.6rem 1rem; padding: 0.7rem 1rem; }
    .syn-nav__links { order: 3; flex-basis: 100%; gap: 0.7rem; flex-wrap: wrap; }
    .syn-nav__right { margin-left: auto; }
  }
  @media (max-width: 480px) {
    .syn-nav__github span { display: none; }
  }
</style>
