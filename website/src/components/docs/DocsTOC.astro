---
import type { DocsHeading } from '~/lib/docs';

export interface Props {
  headings: DocsHeading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filtered.length > 0 && (
  <nav class="docs-toc" aria-label="On this page" data-docs-toc>
    <h4 class="docs-toc__title">On this page</h4>
    <ul class="docs-toc__list" role="list">
      {filtered.map((h) => (
        <li class={`docs-toc__item docs-toc__item--depth-${h.depth}`}>
          <a href={`#${h.slug}`}>
            <span class="docs-toc__bullet" aria-hidden="true"></span>
            <span>{h.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
